# Systemd unit for NeoConf. Adjust APP_DIR paths, then:
#   sudo cp deploy/neoconf.service /etc/systemd/system/neoconf.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now neoconf
#
# Prerequisites (run once as root):
#   sudo useradd --system --home /opt/neoconf --shell /usr/sbin/nologin neoconf
#   sudo mkdir -p /opt/neoconf/my-app
#   sudo chown -R neoconf:neoconf /opt/neoconf
#   # deploy the built app into /opt/neoconf/my-app (git pull / rsync / CI artifact)
#   # put secrets in /opt/neoconf/my-app/.env, then:
#   sudo chown neoconf:neoconf /opt/neoconf/my-app/.env
#   sudo chmod 600 /opt/neoconf/my-app/.env

[Unit]
Description=NeoConf Next.js app
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=neoconf
Group=neoconf
WorkingDirectory=/opt/neoconf/my-app
EnvironmentFile=/opt/neoconf/my-app/.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/env bash ./scripts/start-prod.sh
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=5

# --- Privilege / filesystem hardening ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Only these paths are writable; everything else under ProtectSystem=strict is read-only.
ReadWritePaths=/opt/neoconf/my-app/storage /opt/neoconf/my-app/.next/cache
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# --- Resource limits: keep an overload of one process from taking the box down ---
# Tune these to the server's actual size; these are conservative starting points.
MemoryMax=1G
MemoryHigh=768M
CPUQuota=150%
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
